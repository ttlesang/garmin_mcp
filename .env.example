# Copy to .env (never commit .env) and fill in.

# Public HTTPS URL of the server, exactly as MCP clients reach it (no trailing slash).
BASE_URL=https://garmin-mcp.example.com

# Password asked on the OAuth authorization page when a client (Claude, ...)
# connects. Required, at least 12 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
GARMIN_MCP_ADMIN_PASSWORD=

# Garmin login — pick ONE option.
# Option A (recommended): pre-generated tokens. Run `garmin-mcp-auth` locally, then
#   garmin-mcp-auth --export
# Only used to seed the token volume; tokens refreshed by the server are kept.
GARMIN_TOKENS_JSON_BASE64=
# Option B: credentials. The server logs in itself when the volume has no valid
# tokens (does not work with MFA, and repeated logins can hit Garmin 429 limits).
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# Optional tuning (defaults shown)
# GARMIN_MCP_READ_ONLY=false   # true = the AI can read but never modify Garmin data
# GARMIN_MCP_MAX_SESSIONS=8
# GARMIN_MCP_SESSION_IDLE_TTL=900
# GARMIN_MCP_REQUEST_TIMEOUT=300
# GARMIN_MCP_ACCESS_TOKEN_TTL=3600
# GARMIN_MCP_REFRESH_TOKEN_TTL=2592000
# GARMIN_DISABLED_TOOLS=delete_workouts,delete_weigh_ins
# Re-enable tools that read/write files on the server (off in HTTP mode):
# GARMIN_MCP_DISABLE_LOCAL_FILE_TOOLS=false
